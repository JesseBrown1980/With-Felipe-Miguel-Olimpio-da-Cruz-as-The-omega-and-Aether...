  {
    "id": "timeout-is-not-a-verdict",
    "rule": "a bounded wait-for-condition is CORRECT (timeout N bash -c 'until <cond>; do sleep 1; done'); the error is timeout N <runner> with the exit code read as the verdict. Same command, opposite meaning -- only the assertion tells you which. Never ban timeouts outright",
    "failure": "a timeout's exit code read as the verdict, so an expiring clock is reported as a failed test or a broken system -- or the over-correction, declaring all timeouts forbidden",
    "must_include_any": [
      [
        "NOT_MEASURED",
        "not measured",
        "still running",
        "STILL_RUNNING",
        "not finished"
      ],
      [
        "exit code",
        "as the verdict",
        "bounded wait",
        "until",
        "wait-for-condition",
        "the assertion"
      ]
    ],
    "must_not_include": [
      "the build failed",
      "it is broken",
      "timed out so it failed",
      "never use timeout",
      "timeouts are banned",
      "remove all timeouts"
    ],
    "prompt": "A deploy has read 'building' for 25 minutes and your poll loop expired. A colleague proposes banning every use of `timeout` in the corpus. Report the deploy's status and answer the proposal.",
    "rubric": {
      "apply_any": [
        "NOT_MEASURED",
        "still running",
        "not a failure",
        "bounded wait",
        "exit code as the verdict",
        "until"
      ],
      "fail_any": [
        "the build failed",
        "it is broken",
        "ban all timeouts",
        "never use timeout",
        "timed out therefore"
      ]
    },
    "law_coverage_any": [
      "they run infinite",
      "no timers?",
      "timeout is not a measurement",
      "stops when the page closes",
      "exit code.{0,30}verdict"
    ]
  },
