{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asolaria Draft Promotion Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "policyId",
    "observedAt",
    "verifier",
    "layers",
    "provenanceRequirements",
    "promotionRules"
  ],
  "properties": {
    "schemaId": {
      "const": "asolaria.draft-promotion-policy"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policyId": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verifier": {
      "$ref": "#/$defs/actorRef"
    },
    "layers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/layerDef"
      }
    },
    "provenanceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredTransportFields",
        "canonicalTransportSourceKinds",
        "canonicalTransportStatuses",
        "draftOnlySourceKinds"
      ],
      "properties": {
        "requiredTransportFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "source_kind",
              "host_scope",
              "observed_at",
              "verifier",
              "status"
            ]
          }
        },
        "canonicalTransportSourceKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "live_probe",
              "code_verified"
            ]
          }
        },
        "canonicalTransportStatuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "live",
              "superseded"
            ]
          }
        },
        "draftOnlySourceKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "document_claim",
              "historical_transcript",
              "derived"
            ]
          }
        }
      }
    },
    "promotionRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/promotionRule"
      }
    }
  },
  "$defs": {
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "agent",
            "system"
          ]
        }
      }
    },
    "layerDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "draft",
            "local_canon",
            "shared_canon"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "promotionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromLayer",
        "toLayer",
        "factClass",
        "allowedSourceKinds",
        "allowedStatuses",
        "separateRuntimePacketRequired",
        "resultIfMissingProvenance"
      ],
      "properties": {
        "fromLayer": {
          "type": "string",
          "enum": [
            "draft",
            "local_canon",
            "shared_canon"
          ]
        },
        "toLayer": {
          "type": "string",
          "enum": [
            "draft",
            "local_canon",
            "shared_canon"
          ]
        },
        "factClass": {
          "type": "string",
          "enum": [
            "transport_fact",
            "runtime_status",
            "historical_note",
            "architecture_plan"
          ]
        },
        "allowedSourceKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "live_probe",
              "code_verified",
              "document_claim",
              "historical_transcript",
              "derived"
            ]
          }
        },
        "allowedStatuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "live",
              "stale",
              "proposed",
              "myth",
              "superseded"
            ]
          }
        },
        "requiredFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "source_kind",
              "host_scope",
              "observed_at",
              "verifier",
              "status"
            ]
          }
        },
        "separateRuntimePacketRequired": {
          "type": "boolean"
        },
        "resultIfMissingProvenance": {
          "type": "string",
          "enum": [
            "stay_draft",
            "mark_myth",
            "reject"
          ]
        }
      }
    }
  }
}
