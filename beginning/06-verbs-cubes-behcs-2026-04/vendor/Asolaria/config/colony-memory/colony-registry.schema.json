{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asolaria Colony Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "registryId",
    "observedAt",
    "verifier",
    "sharedLanguage",
    "colonies"
  ],
  "properties": {
    "schemaId": {
      "const": "asolaria.colony-registry"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registryId": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verifier": {
      "$ref": "#/$defs/actorRef"
    },
    "sharedLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sharedCanonNamespace",
        "indexCatalogPath",
        "localCanonNamespaces",
        "draftLayerName"
      ],
      "properties": {
        "sharedCanonNamespace": {
          "type": "string",
          "minLength": 1
        },
        "indexCatalogPath": {
          "type": "string",
          "minLength": 1
        },
        "localCanonNamespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "draftLayerName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "colonies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/colonyEntry"
      }
    }
  },
  "$defs": {
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "owner",
            "agent",
            "system"
          ]
        }
      }
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relayPolicy",
        "mutationPolicy"
      ],
      "properties": {
        "relayPolicy": {
          "type": "string",
          "enum": [
            "manual_owner_relay",
            "policy_bridge",
            "local_only"
          ]
        },
        "mutationPolicy": {
          "type": "string",
          "enum": [
            "owner_only",
            "approval_required",
            "local_only",
            "disabled"
          ]
        }
      }
    },
    "colonyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colonyId",
        "displayName",
        "scope",
        "status",
        "canonNamespaces",
        "catalogPath",
        "draftMemoryPath",
        "retrievalSurfaces",
        "transportRefs",
        "authority"
      ],
      "properties": {
        "colonyId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "parentColonyId": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "sovereign",
            "sub_colony",
            "external_node",
            "phone",
            "service"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "live",
            "stale",
            "planned",
            "offline",
            "historical"
          ]
        },
        "canonNamespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,4}$"
          }
        },
        "catalogPath": {
          "type": "string",
          "minLength": 1
        },
        "draftMemoryPath": {
          "type": "string",
          "minLength": 1
        },
        "retrievalSurfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "workspace_knowledge",
              "mcp_resource",
              "local_memory",
              "local_catalog",
              "notebooklm_mirror"
            ]
          }
        },
        "transportRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority": {
          "$ref": "#/$defs/authorityRef"
        }
      }
    }
  }
}
