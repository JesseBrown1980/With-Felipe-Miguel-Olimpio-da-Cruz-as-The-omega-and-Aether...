    fn payload() -> Vec<u8> {
        (0..4097u32)
            .map(|i| ((i.wrapping_mul(2_654_435_761) >> 11) ^ (i * 17)) as u8)
            .collect()
    }

    fn assert_tuple_row(row: &str) {
        assert!(row.ends_with("|json=0"), "row must end json=0: {}", row);
        assert!(
            !row.contains('{') && !row.contains('}') && !row.contains('"'),
            "row must not be JSON: {}",
            row
        );
    }

